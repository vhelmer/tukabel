{
  "name": "tukabel",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run validate:content && npm run test:rules && npm run build",
    "test:e2e": "npm run build && playwright test",
    "validate:content": "node scripts/validate-content.mjs",
    "test:rules": "node --test scripts/clean-assets.test.mjs && playwright test --config playwright.rules.config.ts",
    "assets:clean": "node scripts/clean-assets.mjs",
    "setup:segmentation": "node scripts/setup-segmentation.mjs",
    "setup:matting": "node scripts/setup-matting.mjs",
    "compare:matting": "node experiments/object-matting/compare.mjs",
    "setup:sam3": "node scripts/setup-sam3.mjs",
    "speech:regenerate": "node scripts/regenerate-speech.mjs",
    "build:release": "npm run typecheck && node scripts/build-release.mjs --budget 5",
    "release:upload": "node scripts/upload-release.mjs",
    "release:cloudfront": "node scripts/setup-cloudfront.mjs",
    "build:azet": "npm run typecheck && node scripts/build-release.mjs --budget 20"
  },
  "dependencies": {
    "@azet/games-sdk": "file:vendor/azet-games-sdk-1.10.0.tgz",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.1160.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@breezystack/lamejs": "^1.2.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
