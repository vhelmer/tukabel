# Pouze pro lokální vývojový Vite server. Zkopíruj do ignorovaného .env.local.
# Nepoužívej prefix VITE_ a klíč nikdy necommituj.
OPENAI_API_KEY=
# Animace používají výhradně fal.ai. OpenAI je ponecháno pro jiné budoucí funkce.
FAL_KEY=
# Volitelně absolutní cesta k vlastnímu FFmpeg, jinak se použije ffmpeg-static.
# FFMPEG_PATH=/usr/bin/ffmpeg
