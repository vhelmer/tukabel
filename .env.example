# Volitelné AI úpravy lokací v Dev Mode. Generování se spouští výslovně.
# Pouze server / ignorovaný .env.local, nikdy prefix VITE_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high

# AI dabing jen v lokalnim Dev Mode. Nikdy prefix VITE_.
ELEVENLABS_API_KEY=
# Absolutni cesta k rozbalenemu Rhubarb (vcetne jeho res/), nebo rhubarb v PATH.
RHUBARB_BIN=

# Volitelná textová réžie existujících animací (pouze Dev Mode).
OPENAI_ANIMATION_MODEL=gpt-4.1-mini

# Lokální segmentace: npm run setup:segmentation, bez placeného API.
# Volitelně jiný Python; jinak .local-tools/segmentation/bin/python nebo python3.
SEGMENTATION_PYTHON=
# Volitelný SAM 2 z oficiálního repozitáře; váhy se nestahují automaticky.
SAM2_CHECKPOINT=
# Pro Large použij configs/sam2.1/sam2.1_hiera_l.yaml a odpovídající checkpoint.
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
# Volitelně jiný lokální adresář ViTMatte. Instalace: npm run setup:matting.
VITMATTE_MODEL=

# SAM 3 má oddělené prostředí; nepřepisuje SAM 2 / ViTMatte.
SAM3_PYTHON=
SAM3_MODEL=
# HF_TOKEN je potřeba jen při explicitním setup:sam3, nikdy za běhu editoru.
HF_TOKEN=
